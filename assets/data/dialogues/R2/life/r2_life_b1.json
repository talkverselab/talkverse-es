 "draft_claude": [
  {
   "tl": "Oye, ¿por qué hay doce sillas en el pasillo?",
   "ko": "야, 복도에 왜 의자가 열두 개나 있어?"
  },
  {
   "tl": "Ni idea. Esta mañana hablé con la vecina del cuarto.",
   "ko": "몰라. 아침에 4층 아주머니랑 얘기하긴 했는데."
  },
  {
   "tl": "¿Con Carmen? Madre mía. ¿Y qué te dijo?",
   "ko": "카르멘 아주머니랑? 세상에. 뭐라고 하셨는데?"
  },
  {
   "tl": "No sé, hablaba muy rápido. Yo solo dije «sí, sí».",
   "ko": "몰라, 말이 너무 빨라서… 난 그냥 「네, 네」만 했어."
  },
  {
   "tl": "¿«Sí, sí»? Tío, ¿a qué dijiste que sí?",
   "ko": "「네, 네」? 야, 뭐에 네라고 한 건데?"
  },
  {
   "tl": "Bueno, a todo. Parecía muy contenta.",
   "ko": "음, 전부 다. 되게 좋아하시던데."
  },
  {
   "tl": "¡Hola, chicos! ¿Dónde pongo la paella?",
   "ko": "얘들아, 안녕! 파에야는 어디다 놓을까?"
  },
  {
   "tl": "¿Qué paella? Perdone, ¿qué pasa aquí?",
   "ko": "무슨 파에야요? 저기요, 지금 이게 무슨 일이에요?"
  },
  {
   "tl": "La reunión de vecinos, en vuestro piso. Somos veinte.",
   "ko": "주민 회의잖니, 너희 집에서. 스무 명이야."
  },
  {
   "tl": "Veinte… Diego, ¿cuántos platos tenemos?",
   "ko": "스무 명… 디에고, 우리 접시 몇 개 있어?"
  },
  {
   "tl": "Tres. La próxima vez, di «no entiendo».",
   "ko": "세 개. 다음엔 「못 알아듣겠어요」라고 해."
  },
  {
   "tl": "Sí, sí.",
   "ko": "네, 네."
  }
